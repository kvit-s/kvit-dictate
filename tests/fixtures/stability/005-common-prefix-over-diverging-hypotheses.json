{
  "id": "005-common-prefix-over-diverging-hypotheses",
  "name": "Only the prefix the last N hypotheses agree on is a candidate",
  "description": "Step 2, on grapheme clusters rather than bytes. The divergence at the tail is where revision concentrates and is exactly what N exists to notice.",
  "params": {
    "hypotheses_n": 2,
    "retract_clusters_m": 3,
    "hold_ms_t": 200
  },
  "steps": [
