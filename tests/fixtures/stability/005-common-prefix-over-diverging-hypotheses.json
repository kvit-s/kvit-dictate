      "op": "reset",
      "utterance_id": 1
    },
    {
      "op": "observe",
      "text": "the meeting is on tuesday afternoon",
      "expect_stable_bytes": 0,
      "expect_high_water": 0
    },
    {
      "op": "observe",
      "text": "the meeting is on thursday afternoon",
      "expect_stable_bytes": 0,
      "expect_high_water": 0
    },
    {
      "op": "advance",
      "ms": 300
    },
    {
      "op": "poll",
      "expect_stable_bytes": 17,
      "expect_high_water": 17
    },
    {
      "op": "observe",
      "text": "the meeting is on thursday afternoon",
      "expect_stable_bytes": 17,
      "expect_high_water": 17
    },
    {
      "op": "advance",
      "ms": 300
    },
    {
      "op": "poll",
      "expect_stable_bytes": 26,
      "expect_high_water": 26
    }
  ],
  "tags": [
